# Public URL of the site (used for metadata, sitemap and robots.txt)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Where demo requests are delivered. Any endpoint that accepts a JSON POST:
# a Zapier/Make webhook, a Slack workflow, your CRM's inbound webhook, etc.
# If unset, requests are only logged on the server.
DEMO_REQUEST_WEBHOOK_URL=

# Optional: link to a scheduling page (Cal.com, Calendly, HubSpot meetings…).
# When set, the booking confirmation shows a "Pick a time now" button.
NEXT_PUBLIC_SCHEDULER_URL=
